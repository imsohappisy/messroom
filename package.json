{
  "name": "messroom",
  "version": "1.0.0",
  "description": "Cross-platform Direct P2P Messenger for Windows and Mac",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.messroom.app",
    "productName": "Messroom",
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.social-networking",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/icon.png"
    }
  },
  "keywords": [
    "p2p",
    "messenger",
    "webrtc",
    "cross-platform",
    "chat"
  ],
  "author": "Sean",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.5",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "ws": "^8.22.1"
  }
}
